{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Slate Music",
  "version": "1.0.1",
  "identifier": "com.spartanac95.slate-music",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slate Music",
        "width": 1440,
        "height": 940,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0b",
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://art.localhost art:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Slate Music"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/SPARTANAC95/slate-music/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQkY5Qjc5OUJFMUZCMUUKUldRZSsrR2JlWnUvSU1ucnZRdE9OOGNHSnFRbllLcFdNcHV0bGd2cVdmYjRKenNZUE0rNkIveXYK",
      "requireSignedVersion": true
    }
  }
}
